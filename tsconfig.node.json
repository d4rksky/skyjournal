{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "electron/**/*.ts",
    "src/lib/types.ts",
    "src/lib/tradeMath.ts",
    "src/lib/backup.ts",
    "src/lib/photoImport.ts"
  ]
}
